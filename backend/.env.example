# Copiez ce fichier vers .env et remplissez avec vos valeurs Supabase.
# Ne commitez JAMAIS le fichier .env (il contient des secrets).

# --- Supabase PostgreSQL ---
# Pooler (port 6543) : utilisé par l'application en runtime
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrations Alembic — essayez dans cet ordre si la connexion échoue :
# 1) Session pooler : postgres.[PROJECT_REF] @ aws-0-[REGION].pooler.supabase.com:5432
# 2) Direct : postgres @ db.[PROJECT_REF].supabase.co:5432
# Sinon exécutez le SQL de la migration dans Supabase → SQL Editor.
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- JWT (générez une clé aléatoire longue, ex. openssl rand -hex 32) ---
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application ---
APP_NAME=5ibra API
DEBUG=true
API_V1_PREFIX=/api/v1

# --- CORS (frontend Next.js local) ---
CORS_ORIGINS=http://localhost:3000

# --- Script scripts/test_api.py (optionnel, ne pas commiter de vrais mots de passe) ---
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_API_PASSWORD=TestPass123!

# --- IA découpage tâches §5.2 ---
# AI_PROVIDER=openai | groq (défaut openai)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
AI_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=          # optionnel, surcharge l'URL par défaut du provider
AI_ENABLED=true
